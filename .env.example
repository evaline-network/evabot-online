# EvaBot backend environment (copy to .env and fill in)

# Google Gemini API key (server-side default for all chat/consilium calls)
GEMINI_API_KEY=

# Default chat model id (see /models for the catalog of 78).
# POLICY 2026-09-08: Gemini on our Google account is RESERVED FOR DEVELOPMENT.
# Runtime chat entry model = OpenRouter Free Models Router (auto-picks live free models; Gemini reserved for development).
DEFAULT_MODEL=openrouter/free

# OpenRouter (community free-tier models — required for :free runtime fleet)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# HTTP server bind
PORT=3000
HOST=0.0.0.0

# OmniRoute LiteLLM free-model proxy (local edge router)
OMNIROUTE_BASE_URL=http://100.66.98.4:20128/v1
OMNIROUTE_API_KEY=omniroute-token

# OpenRouter (community free-tier runtime fleet + fallback)

# OpenCode LLM endpoint (optional)
OPENCODE_BASE_URL=http://100.66.98.4:20128/v1
OPENCODE_API_KEY=

# Telegram bot (long-polling; bot stays disabled when empty)
# Get a token from @BotFather: /newbot -> copy token like 123456789:AA...
TELEGRAM_BOT_TOKEN=
